      "blocks": [
        {
          "kind": "paragraph",
          "text": "A. Cine Paraíso: películas para niños el sábado por la mañana."
        },
        {
          "kind": "paragraph",
          "text": "B. Clases de cocina española los martes por la noche."
        },
