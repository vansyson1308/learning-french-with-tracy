      "kind": "dialogue",
      "blocks": [
        {
          "kind": "line",
          "speaker": "Mateo",
          "text": "Buenos días, un boleto para Sevilla, por favor."
        },
        {
          "kind": "line",
          "speaker": "Agente",
          "text": "Claro. El tren sale a las nueve, andén dos."
        },
        {
          "kind": "line",
          "speaker": "Mateo",
          "text": "¡Gracias! ¿Cuánto cuesta?"
        },
        {
          "kind": "line",
          "speaker": "Agente",
          "text": "Dieciséis euros, señor."
        }
      ],
