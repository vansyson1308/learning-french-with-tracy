{"id": "ko.story.micro_first_meeting", "band": "A1-0", "title": "처음 뵙겠습니다", "blurb": {"vi": "Ngày đầu đi làm, Hương gặp anh Junho và chào hỏi."}, "newLexemes": ["ko:w:ssi", "ko:w:chin-gu", "ko:w:banjangnim"], "tokenMap": {"그분도": "ko:w:geubun", "그분은": "ko:w:geubun", "근로자예요": "ko:w:geulloja", "누구예요": "ko:w:nugu", "뭐예요": "ko:w:mwo", "반장님이에요": "ko:w:banjangnim", "사람이에요": "ko:w:saram", "아내도": "ko:w:anae", "아내예요": "ko:w:anae", "여기는": "ko:w:yeogi", "이름은": "ko:w:ireum", "이분은": "ko:w:ibun", "저는": "ko:w:jeo", "준호": "name", "준호는": "name", "준호예요": "name", "지민은": "name", "지민이에요": "name", "친구예요": "ko:w:chin-gu", "한국이에요": "ko:w:han-guk", "회사원이에요": "ko:w:hoesawon", "훙도": "name", "훙이에요": "name", "흐엉도": "name", "흐엉은": "name", "흐엉의": "name", "흐엉이에요": "name"}, "sentences": [{"speaker": "N", "text": "여기는 한국이에요.", "translation": {"vi": "Đây là Hàn Quốc."}}, {"speaker": "N", "text": "흐엉은 베트남 사람이에요.", "translation": {"vi": "Hương là người Việt Nam."}}, {"speaker": "N", "text": "흐엉은 근로자예요.", "translation": {"vi": "Hương là người lao động."}}, {"speaker": "A", "text": "안녕하세요. 처음 뵙겠습니다.", "translation": {"vi": "Xin chào. Rất hân hạnh được gặp anh."}}, {"speaker": "A", "text": "제 이름은 흐엉이에요.", "translation": {"vi": "Tên em là Hương."}}, {"speaker": "A", "text": "저는 베트남 사람이에요. 잘 부탁드립니다.", "translation": {"vi": "Em là người Việt Nam. Mong anh giúp đỡ."}}, {"speaker": "B", "text": "네, 안녕하세요. 만나서 반갑습니다.", "translation": {"vi": "Vâng, xin chào. Rất vui được gặp em."}}, {"speaker": "B", "text": "저는 준호예요. 저는 한국 사람이에요.", "translation": {"vi": "Anh là Junho. Anh là người Hàn Quốc."}}, {"speaker": "B", "text": "저는 회사원이에요.", "translation": {"vi": "Anh là nhân viên công ty."}}, {"speaker": "N", "text": "준호는 흐엉의 반장님이에요.", "translation": {"vi": "Junho là tổ trưởng của Hương."}}, {"speaker": "A", "text": "준호 씨, 이분은 누구예요?", "translation": {"vi": "Anh Junho ơi, vị này là ai ạ?"}}, {"speaker": "B", "text": "이분은 제 아내예요.", "translation": {"vi": "Đây là vợ anh."}}, {"speaker": "B", "text": "제 아내도 회사원이에요.", "translation": {"vi": "Vợ anh cũng là nhân viên công ty."}}, {"speaker": "A", "text": "그분 이름은 뭐예요?", "translation": {"vi": "Chị ấy tên là gì ạ?"}}, {"speaker": "B", "text": "제 아내 이름은 지민이에요.", "translation": {"vi": "Vợ anh tên là Jimin."}}, {"speaker": "N", "text": "지민은 한국 사람이에요.", "translation": {"vi": "Jimin là người Hàn Quốc."}}, {"speaker": "A", "text": "저기 그분은 누구예요?", "translation": {"vi": "Còn người ở đằng kia là ai ạ?"}}, {"speaker": "B", "text": "그분은 제 친구예요. 베트남 사람이에요.", "translation": {"vi": "Đó là bạn anh. Anh ấy là người Việt Nam."}}, {"speaker": "A", "text": "그분도 근로자예요?", "translation": {"vi": "Anh ấy cũng là người lao động ạ?"}}, {"speaker": "B", "text": "네, 근로자예요. 이름은 훙이에요.", "translation": {"vi": "Ừ, là người lao động. Tên anh ấy là Hùng."}}, {"speaker": "N", "text": "훙도 흐엉도 베트남 사람이에요.", "translation": {"vi": "Hùng và Hương đều là người Việt Nam."}}, {"speaker": "A", "text": "감사합니다.", "translation": {"vi": "Em cảm ơn anh."}}, {"speaker": "B", "text": "아니요, 괜찮아요.", "translation": {"vi": "Không có gì đâu."}}], "questions": [{"kind": "locate", "prompt": {"vi": "Junho là ai của Hương?"}, "options": [{"vi": "Chồng"}, {"vi": "Bạn cùng lớp"}, {"vi": "Tổ trưởng"}], "answer": 2}, {"kind": "locate", "prompt": {"vi": "Vợ của Junho làm nghề gì?"}, "options": [{"vi": "Nhân viên công ty"}, {"vi": "Người lao động"}, {"vi": "Học sinh"}], "answer": 0}, {"kind": "infer", "prompt": {"vi": "Vì sao Hương có thể nói chuyện với anh Hùng bằng tiếng Việt?"}, "options": [{"vi": "Vì anh Hùng là tổ trưởng"}, {"vi": "Vì anh Hùng cũng là người Việt Nam"}, {"vi": "Vì anh Hùng là chồng của Hương"}], "answer": 1}], "sourceRef": "original-project"}
