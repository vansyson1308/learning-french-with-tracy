{"id": "en.write.bac2_b_memo", "taskFamily": "short_message", "mode": "guided", "instruction": {"vi": "Phần 2 — Viết bản ghi nhớ cho cả nhóm: cuộc họp chuyển sang ngày và giờ đã cho, ở phòng đã cho, mọi người mang báo cáo. Có lời chào và lời kết."}, "cueFacts": [{"label": {"vi": "Ngày mới"}, "value": "Thursday"}, {"label": {"vi": "Giờ"}, "value": "3 giờ"}, {"label": {"vi": "Phòng"}, "value": "room 5"}], "rubric": {"requiredSlots": [{"id": "greeting", "description": {"vi": "lời chào"}, "variants": ["dear", "hi", "hello", "to all staff"], "cueProvided": false}, {"id": "day", "description": {"vi": "ngày họp mới"}, "variants": ["thursday"], "cueProvided": true}, {"id": "time", "description": {"vi": "giờ họp"}, "variants": ["at three"], "cueProvided": true}, {"id": "room", "description": {"vi": "phòng họp"}, "variants": ["room five"], "cueProvided": true}, {"id": "report", "description": {"vi": "mang báo cáo"}, "variants": ["report"], "cueProvided": false}, {"id": "closing", "description": {"vi": "lời kết"}, "variants": ["best regards", "regards", "thank you", "thanks"], "cueProvided": false}], "minTokens": 12, "maxTokens": 50}, "modelAnswers": ["To all staff: the meeting will move to Thursday at three in room five. Please bring your report. Thank you, Lan"], "objectiveRefs": ["en.obj.writing.short_message"], "lexemeRefs": ["en:w:staff", "en:w:meeting", "en:w:will", "en:w:move", "en:w:thursday", "en:w:three", "en:w:room", "en:w:five", "en:w:please", "en:w:bring", "en:w:report", "en:w:thank-you"], "scoredEligibility": true, "reserved": true, "sourceRef": "original-project"}
{"id": "en.write.bac2_a_postcard", "taskFamily": "short_message", "mode": "guided", "instruction": {"vi": "Phần 3 — Viết bưu thiếp cho một người bạn: bạn đang nghỉ ở đâu, thời tiết thế nào, bạn làm gì và khi nào về. Có lời chào và lời kết."}, "cueFacts": [{"label": {"vi": "Gửi"}, "value": "Lan"}, {"label": {"vi": "Nơi"}, "value": "Da Nang"}, {"label": {"vi": "Ngày về"}, "value": "Sunday"}], "rubric": {"requiredSlots": [{"id": "greeting", "description": {"vi": "lời chào"}, "variants": ["dear", "hi", "hello"], "cueProvided": false}, {"id": "place", "description": {"vi": "nơi bạn đang nghỉ"}, "variants": ["da nang"], "cueProvided": true}, {"id": "weather", "description": {"vi": "thời tiết"}, "variants": ["weather"], "cueProvided": false}, {"id": "back", "description": {"vi": "ngày về"}, "variants": ["sunday"], "cueProvided": true}, {"id": "closing", "description": {"vi": "lời kết"}, "variants": ["see you", "bye", "goodbye", "best wishes", "love"], "cueProvided": false}], "minTokens": 20, "maxTokens": 60}, "modelAnswers": ["Dear Lan, I am on vacation in Da Nang with my family. The weather is sunny and hot. We swim in the sea every morning. I will come home on Sunday. See you soon, Minh"], "objectiveRefs": ["en.obj.writing.short_message"], "lexemeRefs": ["en:w:dear", "en:w:be", "en:w:vacation", "en:w:family", "en:w:weather", "en:w:hot", "en:w:swim", "en:w:sea", "en:w:morning", "en:w:will", "en:w:come", "en:w:home", "en:w:sunday", "en:w:see-you", "en:w:soon"], "scoredEligibility": true, "reserved": true, "sourceRef": "original-project"}
