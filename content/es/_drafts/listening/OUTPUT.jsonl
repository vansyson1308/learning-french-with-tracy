{"id": "es.clip.dele_a_l1_01", "kind": "dialogue", "segments": [{"speaker": "B", "text": "¿Cuánto cuesta el pan?"}, {"speaker": "A", "text": "Un euro con cincuenta."}], "objectiveRefs": ["es.obj.listening.short_dialogues"], "lexemeRefs": ["es:w:cuanto", "es:w:pan", "es:w:euro", "es:w:cincuenta"], "sourceRef": "original-project", "authoringSpec": {"informationUnits": 1, "inferenceDemand": "locate"}, "scoredPlaybackPolicy": {"maxPlays": 2, "rate": 1}}
{"id": "es.clip.dele_a_l1_02", "kind": "dialogue", "segments": [{"speaker": "B", "text": "Perdón, ¿dónde está el baño?"}, {"speaker": "A", "text": "Al fondo, a la derecha."}], "objectiveRefs": ["es.obj.listening.short_dialogues"], "lexemeRefs": ["es:w:perdon", "es:w:donde", "es:w:bano", "es:w:derecha"], "sourceRef": "original-project", "authoringSpec": {"informationUnits": 1, "inferenceDemand": "locate"}, "scoredPlaybackPolicy": {"maxPlays": 2, "rate": 1}}
{"id": "es.clip.dele_a_l1_03", "kind": "dialogue", "segments": [{"speaker": "B", "text": "¿A qué hora sale el autobús?"}, {"speaker": "A", "text": "A las cuatro y media."}], "objectiveRefs": ["es.obj.listening.short_dialogues"], "lexemeRefs": ["es:w:que", "es:w:hora", "es:w:autobus", "es:w:cuatro"], "sourceRef": "original-project", "authoringSpec": {"informationUnits": 1, "inferenceDemand": "locate"}, "scoredPlaybackPolicy": {"maxPlays": 2, "rate": 1}}
{"id": "es.clip.dele_a_l1_04", "kind": "dialogue", "segments": [{"speaker": "B", "text": "¿Qué quieres beber?"}, {"speaker": "A", "text": "Un zumo de naranja, por favor."}], "objectiveRefs": ["es.obj.listening.short_dialogues"], "lexemeRefs": ["es:w:que", "es:w:beber", "es:w:favor"], "sourceRef": "original-project", "authoringSpec": {"informationUnits": 1, "inferenceDemand": "locate"}, "scoredPlaybackPolicy": {"maxPlays": 2, "rate": 1}}
{"id": "es.clip.dele_a_l1_05", "kind": "dialogue", "segments": [{"speaker": "B", "text": "¿Cuándo es tu cumpleaños?"}, {"speaker": "A", "text": "El doce de mayo."}], "objectiveRefs": ["es.obj.listening.short_dialogues"], "lexemeRefs": ["es:w:cuando", "es:w:cumpleanos", "es:w:doce"], "sourceRef": "original-project", "authoringSpec": {"informationUnits": 1, "inferenceDemand": "locate"}, "scoredPlaybackPolicy": {"maxPlays": 2, "rate": 1}}
{"id": "es.clip.dele_a_l2_01", "kind": "announcement", "segments": [{"speaker": "A", "text": "Atención: el tren para Bilbao sale del andén seis."}], "objectiveRefs": ["es.obj.listening.announcements"], "lexemeRefs": ["es:w:atencion", "es:w:tren", "es:w:anden", "es:w:seis"], "sourceRef": "original-project", "authoringSpec": {"informationUnits": 1, "inferenceDemand": "locate"}, "scoredPlaybackPolicy": {"maxPlays": 2, "rate": 1}}
{"id": "es.clip.dele_a_l2_02", "kind": "announcement", "segments": [{"speaker": "A", "text": "La tienda cierra en diez minutos. Gracias por su visita."}], "objectiveRefs": ["es.obj.listening.announcements"], "lexemeRefs": ["es:w:tienda", "es:w:diez", "es:w:gracias"], "sourceRef": "original-project", "authoringSpec": {"informationUnits": 1, "inferenceDemand": "locate"}, "scoredPlaybackPolicy": {"maxPlays": 2, "rate": 1}}
{"id": "es.clip.dele_a_l2_03", "kind": "message", "segments": [{"speaker": "A", "text": "Hola, soy Pedro. Llego tarde, a las nueve. Lo siento."}], "objectiveRefs": ["es.obj.listening.announcements"], "lexemeRefs": ["es:w:hola", "es:w:tarde", "es:w:nueve"], "sourceRef": "original-project", "authoringSpec": {"informationUnits": 1, "inferenceDemand": "locate"}, "scoredPlaybackPolicy": {"maxPlays": 2, "rate": 1}}
{"id": "es.clip.dele_a_l2_04", "kind": "message", "segments": [{"speaker": "A", "text": "Hoy en Madrid hace sol y mucho calor."}], "objectiveRefs": ["es.obj.listening.announcements"], "lexemeRefs": ["es:w:hoy", "es:w:sol", "es:w:mucho", "es:w:calor"], "sourceRef": "original-project", "authoringSpec": {"informationUnits": 1, "inferenceDemand": "locate"}, "scoredPlaybackPolicy": {"maxPlays": 2, "rate": 1}}
{"id": "es.clip.dele_a_l2_05", "kind": "announcement", "segments": [{"speaker": "A", "text": "Señores pasajeros, el vuelo a Lima sale por la puerta doce."}], "objectiveRefs": ["es.obj.listening.announcements"], "lexemeRefs": ["es:w:puerta", "es:w:doce"], "sourceRef": "original-project", "authoringSpec": {"informationUnits": 1, "inferenceDemand": "locate"}, "scoredPlaybackPolicy": {"maxPlays": 2, "rate": 1}}
{"id": "es.clip.dele_a_l3_01", "kind": "message", "segments": [{"speaker": "A", "text": "Un café con leche y un cruasán, por favor."}], "objectiveRefs": ["es.obj.listening.short_info"], "lexemeRefs": ["es:w:cafe", "es:w:leche", "es:w:favor"], "sourceRef": "original-project", "authoringSpec": {"informationUnits": 1, "inferenceDemand": "locate"}, "scoredPlaybackPolicy": {"maxPlays": 2, "rate": 1}}
{"id": "es.clip.dele_a_l3_02", "kind": "message", "segments": [{"speaker": "A", "text": "Necesito algo para el dolor de cabeza."}], "objectiveRefs": ["es.obj.listening.short_info"], "lexemeRefs": ["es:w:dolor", "es:w:cabeza"], "sourceRef": "original-project", "authoringSpec": {"informationUnits": 1, "inferenceDemand": "locate"}, "scoredPlaybackPolicy": {"maxPlays": 2, "rate": 1}}
{"id": "es.clip.dele_a_l3_03", "kind": "message", "segments": [{"speaker": "A", "text": "Dos entradas para la película de las ocho."}], "objectiveRefs": ["es.obj.listening.short_info"], "lexemeRefs": ["es:w:dos", "es:w:pelicula", "es:w:ocho"], "sourceRef": "original-project", "authoringSpec": {"informationUnits": 1, "inferenceDemand": "locate"}, "scoredPlaybackPolicy": {"maxPlays": 2, "rate": 1}}
{"id": "es.clip.dele_a_l3_04", "kind": "message", "segments": [{"speaker": "A", "text": "Un kilo de tomates y dos de naranjas."}], "objectiveRefs": ["es.obj.listening.short_info"], "lexemeRefs": ["es:w:dos"], "sourceRef": "original-project", "authoringSpec": {"informationUnits": 1, "inferenceDemand": "locate"}, "scoredPlaybackPolicy": {"maxPlays": 2, "rate": 1}}
{"id": "es.clip.dele_a_l3_05", "kind": "message", "segments": [{"speaker": "A", "text": "Tengo una reserva para dos noches, a nombre de García."}], "objectiveRefs": ["es.obj.listening.short_info"], "lexemeRefs": ["es:w:dos", "es:w:nombre"], "sourceRef": "original-project", "authoringSpec": {"informationUnits": 1, "inferenceDemand": "locate"}, "scoredPlaybackPolicy": {"maxPlays": 2, "rate": 1}}
{"id": "es.clip.dele_a_l3_06", "kind": "message", "segments": [{"speaker": "A", "text": "Quiero devolver estos libros."}], "objectiveRefs": ["es.obj.listening.short_info"], "lexemeRefs": ["es:w:quiero", "es:w:devolver"], "sourceRef": "original-project", "authoringSpec": {"informationUnits": 1, "inferenceDemand": "locate"}, "scoredPlaybackPolicy": {"maxPlays": 2, "rate": 1}}
{"id": "es.clip.dele_a_l3_07", "kind": "message", "segments": [{"speaker": "A", "text": "Un billete de ida y vuelta para Granada."}], "objectiveRefs": ["es.obj.listening.short_info"], "lexemeRefs": ["es:w:billete", "es:w:vuelta"], "sourceRef": "original-project", "authoringSpec": {"informationUnits": 1, "inferenceDemand": "locate"}, "scoredPlaybackPolicy": {"maxPlays": 2, "rate": 1}}
{"id": "es.clip.dele_a_l3_08", "kind": "message", "segments": [{"speaker": "A", "text": "Un poco más corto, por favor. Solo el pelo de atrás."}], "objectiveRefs": ["es.obj.listening.short_info"], "lexemeRefs": ["es:w:favor", "es:w:solo", "es:w:pelo"], "sourceRef": "original-project", "authoringSpec": {"informationUnits": 1, "inferenceDemand": "locate"}, "scoredPlaybackPolicy": {"maxPlays": 2, "rate": 1}}
{"id": "es.clip.dele_a_l4_01", "kind": "factual", "segments": [{"speaker": "A", "text": "El museo abre a las diez y cierra a las seis."}], "objectiveRefs": ["es.obj.listening.short_info"], "lexemeRefs": ["es:w:museo", "es:w:diez", "es:w:seis"], "sourceRef": "original-project", "authoringSpec": {"informationUnits": 1, "inferenceDemand": "locate"}, "scoredPlaybackPolicy": {"maxPlays": 2, "rate": 1}}
{"id": "es.clip.dele_a_l4_02", "kind": "factual", "segments": [{"speaker": "A", "text": "La entrada cuesta quince euros."}], "objectiveRefs": ["es.obj.listening.short_info"], "lexemeRefs": ["es:w:entrada", "es:w:quince"], "sourceRef": "original-project", "authoringSpec": {"informationUnits": 1, "inferenceDemand": "locate"}, "scoredPlaybackPolicy": {"maxPlays": 2, "rate": 1}}
{"id": "es.clip.dele_a_l4_03", "kind": "message", "segments": [{"speaker": "A", "text": "Vivo en la calle Sol, número veinte."}], "objectiveRefs": ["es.obj.listening.short_info"], "lexemeRefs": ["es:w:calle", "es:w:sol", "es:w:numero", "es:w:veinte"], "sourceRef": "original-project", "authoringSpec": {"informationUnits": 1, "inferenceDemand": "locate"}, "scoredPlaybackPolicy": {"maxPlays": 2, "rate": 1}}
{"id": "es.clip.dele_a_l4_04", "kind": "factual", "segments": [{"speaker": "A", "text": "La clase empieza a las nueve menos cuarto."}], "objectiveRefs": ["es.obj.listening.short_info"], "lexemeRefs": ["es:w:clase", "es:w:nueve"], "sourceRef": "original-project", "authoringSpec": {"informationUnits": 1, "inferenceDemand": "locate"}, "scoredPlaybackPolicy": {"maxPlays": 2, "rate": 1}}
{"id": "es.clip.dele_a_l4_05", "kind": "message", "segments": [{"speaker": "A", "text": "Tengo dos hermanos y una hermana."}], "objectiveRefs": ["es.obj.listening.short_info"], "lexemeRefs": ["es:w:dos", "es:w:hermanos", "es:w:hermana"], "sourceRef": "original-project", "authoringSpec": {"informationUnits": 1, "inferenceDemand": "locate"}, "scoredPlaybackPolicy": {"maxPlays": 2, "rate": 1}}
{"id": "es.clip.dele_a_l4_06", "kind": "factual", "segments": [{"speaker": "A", "text": "El concierto es el viernes por la noche."}], "objectiveRefs": ["es.obj.listening.short_info"], "lexemeRefs": ["es:w:viernes", "es:w:noche"], "sourceRef": "original-project", "authoringSpec": {"informationUnits": 1, "inferenceDemand": "locate"}, "scoredPlaybackPolicy": {"maxPlays": 2, "rate": 1}}
{"id": "es.clip.dele_a_l4_07", "kind": "message", "segments": [{"speaker": "A", "text": "Son cuatro euros con veinte, por favor."}], "objectiveRefs": ["es.obj.listening.short_info"], "lexemeRefs": ["es:w:son", "es:w:cuatro", "es:w:veinte", "es:w:favor"], "sourceRef": "original-project", "authoringSpec": {"informationUnits": 1, "inferenceDemand": "locate"}, "scoredPlaybackPolicy": {"maxPlays": 2, "rate": 1}}
{"id": "es.clip.dele_b_l1_01", "kind": "dialogue", "segments": [{"speaker": "B", "text": "¿Cuánto es todo?"}, {"speaker": "A", "text": "Son ocho euros."}], "objectiveRefs": ["es.obj.listening.short_dialogues"], "lexemeRefs": ["es:w:cuanto", "es:w:son", "es:w:ocho"], "sourceRef": "original-project", "authoringSpec": {"informationUnits": 1, "inferenceDemand": "locate"}, "scoredPlaybackPolicy": {"maxPlays": 2, "rate": 1}}
{"id": "es.clip.dele_b_l1_02", "kind": "dialogue", "segments": [{"speaker": "B", "text": "¿Dónde está la estación?"}, {"speaker": "A", "text": "Todo recto y después a la izquierda."}], "objectiveRefs": ["es.obj.listening.short_dialogues"], "lexemeRefs": ["es:w:donde", "es:w:estacion", "es:w:recto", "es:w:despues", "es:w:izquierda"], "sourceRef": "original-project", "authoringSpec": {"informationUnits": 1, "inferenceDemand": "locate"}, "scoredPlaybackPolicy": {"maxPlays": 2, "rate": 1}}
{"id": "es.clip.dele_b_l1_03", "kind": "dialogue", "segments": [{"speaker": "B", "text": "¿A qué hora abre el banco?"}, {"speaker": "A", "text": "A las ocho y media."}], "objectiveRefs": ["es.obj.listening.short_dialogues"], "lexemeRefs": ["es:w:que", "es:w:hora", "es:w:banco", "es:w:ocho"], "sourceRef": "original-project", "authoringSpec": {"informationUnits": 1, "inferenceDemand": "locate"}, "scoredPlaybackPolicy": {"maxPlays": 2, "rate": 1}}
{"id": "es.clip.dele_b_l1_04", "kind": "dialogue", "segments": [{"speaker": "B", "text": "¿Qué vas a comer?"}, {"speaker": "A", "text": "Pollo con arroz."}], "objectiveRefs": ["es.obj.listening.short_dialogues"], "lexemeRefs": ["es:w:que", "es:w:comer", "es:w:pollo", "es:w:arroz"], "sourceRef": "original-project", "authoringSpec": {"informationUnits": 1, "inferenceDemand": "locate"}, "scoredPlaybackPolicy": {"maxPlays": 2, "rate": 1}}
{"id": "es.clip.dele_b_l1_05", "kind": "dialogue", "segments": [{"speaker": "B", "text": "¿Cuándo es la fiesta?"}, {"speaker": "A", "text": "El sábado a las ocho."}], "objectiveRefs": ["es.obj.listening.short_dialogues"], "lexemeRefs": ["es:w:cuando", "es:w:fiesta", "es:w:sabado", "es:w:ocho"], "sourceRef": "original-project", "authoringSpec": {"informationUnits": 1, "inferenceDemand": "locate"}, "scoredPlaybackPolicy": {"maxPlays": 2, "rate": 1}}
{"id": "es.clip.dele_b_l2_01", "kind": "announcement", "segments": [{"speaker": "A", "text": "Atención: hoy el autobús número cinco no funciona."}], "objectiveRefs": ["es.obj.listening.announcements"], "lexemeRefs": ["es:w:atencion", "es:w:hoy", "es:w:autobus", "es:w:numero", "es:w:cinco"], "sourceRef": "original-project", "authoringSpec": {"informationUnits": 1, "inferenceDemand": "locate"}, "scoredPlaybackPolicy": {"maxPlays": 2, "rate": 1}}
{"id": "es.clip.dele_b_l2_02", "kind": "announcement", "segments": [{"speaker": "A", "text": "Hoy el supermercado está abierto hasta las diez de la noche."}], "objectiveRefs": ["es.obj.listening.announcements"], "lexemeRefs": ["es:w:hoy", "es:w:abierto", "es:w:diez", "es:w:noche"], "sourceRef": "original-project", "authoringSpec": {"informationUnits": 1, "inferenceDemand": "locate"}, "scoredPlaybackPolicy": {"maxPlays": 2, "rate": 1}}
{"id": "es.clip.dele_b_l2_03", "kind": "message", "segments": [{"speaker": "A", "text": "Hola, mamá. Estoy en casa de Ana. Vuelvo a las siete."}], "objectiveRefs": ["es.obj.listening.announcements"], "lexemeRefs": ["es:w:hola", "es:w:mama", "es:w:casa", "es:w:siete"], "sourceRef": "original-project", "authoringSpec": {"informationUnits": 1, "inferenceDemand": "locate"}, "scoredPlaybackPolicy": {"maxPlays": 2, "rate": 1}}
{"id": "es.clip.dele_b_l2_04", "kind": "message", "segments": [{"speaker": "A", "text": "Mañana va a llover en Barcelona."}], "objectiveRefs": ["es.obj.listening.announcements"], "lexemeRefs": ["es:w:manana"], "sourceRef": "original-project", "authoringSpec": {"informationUnits": 1, "inferenceDemand": "locate"}, "scoredPlaybackPolicy": {"maxPlays": 2, "rate": 1}}
{"id": "es.clip.dele_b_l2_05", "kind": "announcement", "segments": [{"speaker": "A", "text": "El tren para Málaga llega con veinte minutos de retraso."}], "objectiveRefs": ["es.obj.listening.announcements"], "lexemeRefs": ["es:w:tren", "es:w:veinte"], "sourceRef": "original-project", "authoringSpec": {"informationUnits": 1, "inferenceDemand": "locate"}, "scoredPlaybackPolicy": {"maxPlays": 2, "rate": 1}}
{"id": "es.clip.dele_b_l3_01", "kind": "message", "segments": [{"speaker": "A", "text": "¿Tiene esta camisa en una talla más grande?"}], "objectiveRefs": ["es.obj.listening.short_info"], "lexemeRefs": ["es:w:camisa", "es:w:grande"], "sourceRef": "original-project", "authoringSpec": {"informationUnits": 1, "inferenceDemand": "locate"}, "scoredPlaybackPolicy": {"maxPlays": 2, "rate": 1}}
{"id": "es.clip.dele_b_l3_02", "kind": "message", "segments": [{"speaker": "A", "text": "Quiero cambiar cien dólares a euros."}], "objectiveRefs": ["es.obj.listening.short_info"], "lexemeRefs": ["es:w:quiero", "es:w:cambiar", "es:w:cien"], "sourceRef": "original-project", "authoringSpec": {"informationUnits": 1, "inferenceDemand": "locate"}, "scoredPlaybackPolicy": {"maxPlays": 2, "rate": 1}}
{"id": "es.clip.dele_b_l3_03", "kind": "message", "segments": [{"speaker": "A", "text": "La cuenta, por favor."}], "objectiveRefs": ["es.obj.listening.short_info"], "lexemeRefs": ["es:w:cuenta", "es:w:favor"], "sourceRef": "original-project", "authoringSpec": {"informationUnits": 1, "inferenceDemand": "locate"}, "scoredPlaybackPolicy": {"maxPlays": 2, "rate": 1}}
{"id": "es.clip.dele_b_l3_04", "kind": "message", "segments": [{"speaker": "A", "text": "Doctor, me duele el estómago desde ayer."}], "objectiveRefs": ["es.obj.listening.short_info"], "lexemeRefs": ["es:w:doctor", "es:w:ayer"], "sourceRef": "original-project", "authoringSpec": {"informationUnits": 1, "inferenceDemand": "locate"}, "scoredPlaybackPolicy": {"maxPlays": 2, "rate": 1}}
{"id": "es.clip.dele_b_l3_05", "kind": "message", "segments": [{"speaker": "A", "text": "Quiero enviar esta carta a Vietnam."}], "objectiveRefs": ["es.obj.listening.short_info"], "lexemeRefs": ["es:w:quiero", "es:w:enviar"], "sourceRef": "original-project", "authoringSpec": {"informationUnits": 1, "inferenceDemand": "locate"}, "scoredPlaybackPolicy": {"maxPlays": 2, "rate": 1}}
{"id": "es.clip.dele_b_l3_06", "kind": "message", "segments": [{"speaker": "A", "text": "¿A qué hora sale el avión para Roma?"}], "objectiveRefs": ["es.obj.listening.short_info"], "lexemeRefs": ["es:w:que", "es:w:hora", "es:w:avion"], "sourceRef": "original-project", "authoringSpec": {"informationUnits": 1, "inferenceDemand": "locate"}, "scoredPlaybackPolicy": {"maxPlays": 2, "rate": 1}}
{"id": "es.clip.dele_b_l3_07", "kind": "message", "segments": [{"speaker": "A", "text": "Una barra de pan y dos cruasanes, por favor."}], "objectiveRefs": ["es.obj.listening.short_info"], "lexemeRefs": ["es:w:pan", "es:w:dos", "es:w:favor"], "sourceRef": "original-project", "authoringSpec": {"informationUnits": 1, "inferenceDemand": "locate"}, "scoredPlaybackPolicy": {"maxPlays": 2, "rate": 1}}
{"id": "es.clip.dele_b_l3_08", "kind": "message", "segments": [{"speaker": "A", "text": "Abran el libro en la página diez, por favor."}], "objectiveRefs": ["es.obj.listening.short_info"], "lexemeRefs": ["es:w:libro", "es:w:diez", "es:w:favor"], "sourceRef": "original-project", "authoringSpec": {"informationUnits": 1, "inferenceDemand": "locate"}, "scoredPlaybackPolicy": {"maxPlays": 2, "rate": 1}}
{"id": "es.clip.dele_b_l4_01", "kind": "factual", "segments": [{"speaker": "A", "text": "La farmacia abre a las nueve y cierra a las ocho."}], "objectiveRefs": ["es.obj.listening.short_info"], "lexemeRefs": ["es:w:farmacia", "es:w:nueve", "es:w:ocho"], "sourceRef": "original-project", "authoringSpec": {"informationUnits": 1, "inferenceDemand": "locate"}, "scoredPlaybackPolicy": {"maxPlays": 2, "rate": 1}}
{"id": "es.clip.dele_b_l4_02", "kind": "factual", "segments": [{"speaker": "A", "text": "El billete cuesta treinta euros."}], "objectiveRefs": ["es.obj.listening.short_info"], "lexemeRefs": ["es:w:billete", "es:w:treinta"], "sourceRef": "original-project", "authoringSpec": {"informationUnits": 1, "inferenceDemand": "locate"}, "scoredPlaybackPolicy": {"maxPlays": 2, "rate": 1}}
{"id": "es.clip.dele_b_l4_03", "kind": "message", "segments": [{"speaker": "A", "text": "Mi casa está en la calle Luna, número quince."}], "objectiveRefs": ["es.obj.listening.short_info"], "lexemeRefs": ["es:w:casa", "es:w:calle", "es:w:luna", "es:w:numero", "es:w:quince"], "sourceRef": "original-project", "authoringSpec": {"informationUnits": 1, "inferenceDemand": "locate"}, "scoredPlaybackPolicy": {"maxPlays": 2, "rate": 1}}
{"id": "es.clip.dele_b_l4_04", "kind": "factual", "segments": [{"speaker": "A", "text": "La película empieza a las diez y cuarto."}], "objectiveRefs": ["es.obj.listening.short_info"], "lexemeRefs": ["es:w:pelicula", "es:w:diez"], "sourceRef": "original-project", "authoringSpec": {"informationUnits": 1, "inferenceDemand": "locate"}, "scoredPlaybackPolicy": {"maxPlays": 2, "rate": 1}}
{"id": "es.clip.dele_b_l4_05", "kind": "message", "segments": [{"speaker": "A", "text": "Tengo tres hijos: dos niñas y un niño."}], "objectiveRefs": ["es.obj.listening.short_info"], "lexemeRefs": ["es:w:tres", "es:w:dos", "es:w:nino"], "sourceRef": "original-project", "authoringSpec": {"informationUnits": 1, "inferenceDemand": "locate"}, "scoredPlaybackPolicy": {"maxPlays": 2, "rate": 1}}
{"id": "es.clip.dele_b_l4_06", "kind": "factual", "segments": [{"speaker": "A", "text": "La reunión es el lunes por la mañana."}], "objectiveRefs": ["es.obj.listening.short_info"], "lexemeRefs": ["es:w:reunion", "es:w:lunes", "es:w:manana"], "sourceRef": "original-project", "authoringSpec": {"informationUnits": 1, "inferenceDemand": "locate"}, "scoredPlaybackPolicy": {"maxPlays": 2, "rate": 1}}
