{"id": "es.read.dele_b_r3_anuncios", "kind": "notice", "title": "Anuncios", "blocks": [{"kind": "paragraph", "text": "A. Cine Paraíso: películas para niños el sábado por la mañana."}, {"kind": "paragraph", "text": "B. Clases de cocina española los martes por la noche."}, {"kind": "paragraph", "text": "C. Taxi: veinticuatro horas, todos los días."}, {"kind": "paragraph", "text": "D. Mercado de frutas en la plaza, todos los días."}, {"kind": "paragraph", "text": "E. Piscina: clases de natación para adultos."}, {"kind": "paragraph", "text": "F. Tienda de ropa: zapatos y abrigos baratos."}, {"kind": "paragraph", "text": "G. Parque de animales: abierto todo el año."}, {"kind": "paragraph", "text": "H. Hostal Centro: habitaciones baratas cerca de la estación."}], "objectiveRefs": ["es.obj.reading.notices_info"], "lexemeRefs": ["es:w:cine", "es:w:sabado", "es:w:manana", "es:w:martes", "es:w:noche", "es:w:taxi", "es:w:mercado", "es:w:plaza"], "supportGlossary": [{"surface": "cocina", "gloss": {"vi": "nấu ăn", "en": "cooking"}}, {"surface": "natación", "gloss": {"vi": "bơi", "en": "swimming"}}, {"surface": "abrigos", "gloss": {"vi": "áo khoác", "en": "coats"}}, {"surface": "Hostal", "gloss": {"vi": "Nhà nghỉ", "en": "Hostel"}}], "sourceRef": "original-project", "authoringSpec": {"informationUnits": 6, "inferenceDemand": "basic_inference"}}
