{"id": "de.write.goethe_a_nachricht", "taskFamily": "short_message", "mode": "guided", "instruction": {"vi": "Teil 2 — Bạn có sinh nhật vào thứ Bảy. Hãy viết cho bạn của bạn là Paul (khoảng 30 từ): mời anh ấy đến dự tiệc, nói giờ bắt đầu, và nhờ anh ấy mang đồ uống. Có lời chào và lời chào kết.", "en": "Teil 2 — Bạn có sinh nhật vào thứ Bảy. Hãy viết cho bạn của bạn là Paul (khoảng 30 từ): mời anh ấy đến dự tiệc, nói giờ bắt đầu, và nhờ anh ấy mang đồ uống. Có lời chào và lời chào kết."}, "cueFacts": [{"label": {"vi": "Gửi", "en": "Gửi"}, "value": "Paul"}, {"label": {"vi": "Khi nào", "en": "Khi nào"}, "value": "Samstag, 19 Uhr"}, {"label": {"vi": "Nhờ mang", "en": "Nhờ mang"}, "value": "Getränke"}], "rubric": {"requiredSlots": [{"id": "greeting", "description": {"vi": "lời chào", "en": "lời chào"}, "variants": ["hallo", "hi", "liebe", "lieber", "guten tag", "sehr geehrte"], "cueProvided": false}, {"id": "invite", "description": {"vi": "lời mời dự tiệc", "en": "lời mời dự tiệc"}, "variants": ["kommst du", "komm doch", "lade dich ein", "möchtest du kommen"], "cueProvided": false}, {"id": "time", "description": {"vi": "giờ bắt đầu", "en": "giờ bắt đầu"}, "variants": ["um 19 uhr", "um sieben", "um 7", "um neunzehn uhr"], "cueProvided": true}, {"id": "bring", "description": {"vi": "nhờ mang đồ uống", "en": "nhờ mang đồ uống"}, "variants": ["getränke", "trinken", "saft", "wasser", "cola"], "cueProvided": true}, {"id": "closing", "description": {"vi": "lời chào kết", "en": "lời chào kết"}, "variants": ["viele grüße", "liebe grüße", "bis bald", "tschüss", "mit freundlichen grüßen", "bis dann"], "cueProvided": false}], "minTokens": 20, "maxTokens": 45}, "modelAnswers": ["Lieber Paul, am Samstag habe ich Geburtstag und ich mache eine Party. Kommst du auch? Die Party beginnt um 19 Uhr. Kannst du bitte Getränke mitbringen? Viele Grüße, Lan"], "objectiveRefs": ["de.obj.writing.short_message"], "lexemeRefs": ["de:w:geburtstag", "de:w:samstag"], "scoredEligibility": true, "reserve