{"id": "de.read.uj_bahnhof", "kind": "description", "title": "Der Bahnhof am Morgen", "blocks": [{"kind": "paragraph", "text": "Es ist sieben Uhr. Am Bahnhof sind viele Menschen. Ein Zug kommt, ein Zug fährt. Eine Frau kauft ein Ticket. Ein Kind trinkt Milch."}], "objectiveRefs": ["de.obj.reading.short_texts"], "lexemeRefs": ["de:w:sein", "de:w:uhr", "de:w:bahnhof", "de:w:zug", "de:w:kommen", "de:w:fahren", "de:w:frau", "de:w:kaufen", "de:w:ticket", "de:w:kind", "de:w:trinken", "de:w:milch"], "supportGlossary": [{"surface": "viele", "gloss": {"vi": "nhiều", "en": "many"}}], "sourceRef": "original-project", "authoringSpec": {"informationUnits": 4, "inferenceDemand": "locate"}}
