{"id": "de.read.uj_mia", "kind": "narrative", "title": "Mia fährt zur Arbeit", "blocks": [{"kind": "paragraph", "text": "Mia wohnt in Köln. Am Montag fährt sie mit dem Bus zur Arbeit. Die Arbeit beginnt um acht Uhr. Am Abend kocht sie mit ihrem Bruder."}], "objectiveRefs": ["de.obj.reading.short_texts"], "lexemeRefs": ["de:w:wohnen", "de:w:montag", "de:w:fahren", "de:w:bus", "de:w:arbeit", "de:w:uhr", "de:w:abend", "de:w:bruder"], "supportGlossary": [{"surface": "beginnt", "gloss": {"vi": "bắt đầu", "en": "begins"}}, {"surface": "kocht", "gloss": {"vi": "nấu ăn", "en": "cooks"}}], "sourceRef": "original-project", "authoringSpec": {"informationUnits": 4, "inferenceDemand": "locate"}}
