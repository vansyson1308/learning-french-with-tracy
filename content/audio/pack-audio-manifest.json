{
  "version": 1,
  "pipelineVersion": 1,
  "note": "Bundled course audio for every word, phrase and sentence the packs reference. Every voice is a candidate until the dispatch-only pack-audio workflow (recon) double-downloads it, pins its hashes, reads its MODEL_CARD and applies the license gate FAIL-CLOSED; the canary ASR audit then selects one eligible voice per course. Model weights are used on the runner and never committed. Courses whose language has no Piper voice keep no bundled audio and use the device's text-to-speech (policy device-tts).",
  "piperTts": {
    "package": "piper-tts",
    "pinnedVersion": "1.2.0"
  },
  "voicesRepository": "https://huggingface.co/rhasspy/piper-voices",
  "voicesRevision": "v1.0.0",
  "licenseGate": {
    "note": "Same posture as the reception pipeline (CC BY 4.0 / CC BY-SA 4.0 accepted, share-alike deliberately accepted because the project already publishes derived data under CC BY-SA 4.0 with an in-app attributions screen) plus CC0 / public-domain datasets, which are strictly more permissive. AGPL/GPL/NC/ND remain denied. A voice whose card matches nothing is excluded, never guessed.",
    "allow": [
      "CC BY 4.0",
      "CC-BY-4.0",
      "CC BY 4",
      "cc-by-4.0",
      "CC BY-SA 4.0",
      "CC-BY-SA-4.0",
      "creativecommons.org/licenses/by/4.0",
      "creativecommons.org/licenses/by-sa/4.0",
      "CC0",
      "CC0 1.0",
      "creativecommons.org/publicdomain/zero/1.0",
      "public domain"
    ],
    "deny": [
      "AGPL",
      "GPL",
      "NC",
      "ND",
      "non-commercial",
      "noncommercial"
    ]
  },
