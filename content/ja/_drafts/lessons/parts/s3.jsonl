{"lessonId": "ja-vi:uj-l0", "exercises": [{"type": "select", "id": "ja-vi:uj-l0-e0", "mode": "targetToNative", "prompt": "ナムさんの寮は駅の近くです。", "audioTarget": "ナムさんの寮は駅の近くです。", "options": [{"text": "Ký túc xá của Nam ở xa ga."}, {"text": "Ký túc xá của Nam ở gần ga."}, {"text": "Nam sống ở gần công ty."}, {"text": "Nhà ga ở trong ký túc xá."}], "correct": 1}, {"type": "select", "id": "ja-vi:uj-l0-e1", "mode": "targetToNative", "prompt": "ナムさんは毎朝6時に起きます。", "audioTarget": "ナムさんは毎朝6時に起きます。", "options": [{"text": "Sáng nào Nam cũng ngủ đến sáu giờ."}, {"text": "Tối nào Nam cũng ngủ lúc sáu giờ."}, {"text": "Sáng nào Nam cũng dậy lúc sáu giờ."}, {"text": "Sáng nay Nam dậy lúc sáu giờ."}], "correct": 2}, {"type": "select", "id": "ja-vi:uj-l0-e2", "mode": "targetToNative", "prompt": "朝ご飯を食べて、7時に寮を出ます。", "audioTarget": "朝ご飯を食べて、7時に寮を出ます。", "options": [{"text": "Bảy giờ Nam ăn sáng ở ký túc xá."}, {"text": "Bảy giờ Nam về ký túc xá."}, {"text": "Nam không ăn sáng."}, {"text": "Ăn sáng xong, bảy giờ Nam rời ký túc xá."}], "correct": 3}, {"type": "select", "id": "ja-vi:uj-l0-e3", "mode": "targetToNative", "prompt": "寮", "audioTarget": "寮", "options": [{"text": "ký túc xá"}, {"text": "phòng"}, {"text": "nhà"}, {"text": "công ty"}], "correct": 0}, {"type": "fillBlank", "id": "ja-vi:uj-l0-e4", "sentence": "夜は___で晩ご飯を食べます。", "translation": "Buổi tối Nam ăn tối ở nhà ăn.", "audioTarget": "夜は食堂で晩ご飯を食べます。", "options": ["銀行", "食堂", "空港", "郵便局"], "correct": 1}, {"type": "wordBank", "id": "ja-vi:uj-l0-e5", "direction": "targetToNative", "prompt": "ナムさんは工場で働きます。", "audioTarget": "ナムさんは工場で働きます。", "tokens": ["ở", "học", "làm việc", "công ty", "Nam", "nhà máy"], "answer": ["Nam", "làm việc", "ở", "nhà máy"]}, {"type": "typeAnswer", "id": "ja-vi:uj-l0-e6", "mode": "produceTarget", "prompt": "Ký túc xá ở gần ga.", "audioTarget": "寮は駅の近くです", "answer": "寮は駅の近くです", "alternatives": ["寮は駅から近いです"]}], "flow": [{"concept": "ja:concept:sov-subject"}, {"exercise": "ja-vi:uj-l0-e0"}, {"exercise": "ja-vi:uj-l